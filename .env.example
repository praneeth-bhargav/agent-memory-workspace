OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Independent evaluation judge; stronger than the default agent model after observed false positives.
EVAL_JUDGE_MODEL=gpt-5.4
# Optional: used only by the explicit eval --langsmith command. Never commit the real key.
LANGSMITH_API_KEY=
# Uncomment for a non-default regional/self-hosted endpoint or multi-workspace key.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Keep app/global tracing off; --langsmith enables tracing only for synthetic evals.
LANGSMITH_TRACING=false
# Enable only if IPv6 connections to OpenAI time out on your network.
AGENT_OPENAI_IPV4_ONLY=false
# Opt in to the scheduler, memory extraction and indexing workers.
AGENT_ENABLE_BACKGROUND_JOBS=false
# Set rates for your configured model to see estimated costs.
OPENAI_INPUT_USD_PER_MILLION=0.75
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.075
OPENAI_OUTPUT_USD_PER_MILLION=4.5
OPENAI_EMBEDDING_USD_PER_MILLION=0.02
